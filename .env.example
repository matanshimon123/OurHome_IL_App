# ──────────────────────────────────────────────────────────────
# OurHome IL — environment variable template
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. .env is gitignored; this
# file is the committed, PLACEHOLDER-ONLY template.
# NEVER put a real secret in this file.
# ──────────────────────────────────────────────────────────────


# ──────────────────────────────────────────────
# FLASK / SESSION — app.py
# ──────────────────────────────────────────────

# Which environment this process runs in: 'development' (default) or 'production'.
# MUST be 'production' on the server — that makes app.py REFUSE TO START when
# SECRET_KEY/JWT_SECRET are missing or still a known-weak default. Any other
# value only prints a startup warning, so local dev keeps working with no env.
APP_ENV=development

# Flask session signing key. REQUIRED in production.
# Default if unset: 'dev-key-change-in-production' (unsafe).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NOTE: the placeholder below contains 'change-me' and is deliberately rejected
# by the APP_ENV=production guard — copying this file verbatim will not boot.
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# HS256 signing key for the mobile/API JWTs. Optional — falls back to
# SECRET_KEY when unset. Set it to a SEPARATE random value in production.
JWT_SECRET=change-me-generate-with-secrets-token-hex-32

# Port the Flask dev server binds to. Optional, default: 5000
PORT=5000


# ──────────────────────────────────────────────
# DATABASE — app.py
# ──────────────────────────────────────────────

# Path to the SQLite database file. Optional, default: finance_tracker.db
DATABASE_PATH=finance_tracker.db


# ──────────────────────────────────────────────
# FIREBASE AUTH — firebase_config.py
# ──────────────────────────────────────────────

# Firebase Web API key, used for the Identity Toolkit REST calls
# (login / password reset). Public by design (it names the project), but
# there is NO in-source default: REQUIRED in production, where
# firebase_config.py REFUSES TO START without it. Unset outside production
# only prints a warning and disables Firebase login / password reset;
# the local-password login path keeps working.
# Find it in Firebase console > Project settings > General > Web API Key.
FIREBASE_API_KEY=your-firebase-web-api-key

# Admin SDK service account. Use EXACTLY ONE of the two below.
#
# Option A (recommended): absolute path to the service account JSON,
# stored OUTSIDE this repository so it can never be committed.
# Optional — default: serviceAccountKey.json in the repo root, which
# triggers a startup warning because it sits inside the working tree.
FIREBASE_CREDENTIALS_PATH=/absolute/path/outside/repo/serviceAccountKey.json

# Option B: the service account JSON inline, on one line. Preferred for
# containers / CI where mounting a file is awkward. Takes precedence over
# FIREBASE_CREDENTIALS_PATH when both are set. Optional.
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE-ME\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com"}

# If neither is set and no file is found, Firebase Auth is disabled and
# the app logs "Firebase credentials not found — Auth disabled".


# ──────────────────────────────────────────────
# PUSH NOTIFICATIONS (FCM V1) — app.py
# ──────────────────────────────────────────────

# Path to the FCM service account JSON. Optional — default:
# firebase-service-account.json in the repo root. Point it outside the
# repo. Without it, send_push_to_family() silently no-ops.
FCM_SERVICE_ACCOUNT=/absolute/path/outside/repo/firebase-service-account.json


# ──────────────────────────────────────────────
# EMAIL (Flask-Mail, Gmail SMTP) — app.py
# ──────────────────────────────────────────────

# Gmail address used as SMTP login and as the default sender.
# Optional — email features are inert when unset.
MAIL_USERNAME=your-address@gmail.com

# Gmail APP PASSWORD (not the account password). Optional.
MAIL_PASSWORD=your-16-char-gmail-app-password


# ──────────────────────────────────────────────
# DEPLOYMENT ONLY (container runtime, not read by app code)
# ──────────────────────────────────────────────

# Container timezone. Optional. App logic uses a hardcoded
# Asia/Jerusalem zone regardless.
TZ=Asia/Jerusalem

# Session signing key for the LEGACY finance-app container in
# docker-compose-new.yml (a different codebase — not read by this app). Kept as
# its own variable so the legacy app's key stays independent of SECRET_KEY above.
# REQUIRED: the compose file fails the deploy if it is unset.
FINANCE_APP_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# docker-compose-new.yml also needs SSL_EMAIL, DOMAIN_NAME, SUBDOMAIN and
# GENERIC_TIMEZONE for the Traefik/n8n services. Those are pre-existing
# deployment values, not secrets, and live in the same server-side .env.
